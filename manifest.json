{
  "manifest_version": 3,
  "name": "Switchy",
  "version": "0.4.2",
  "description": "A sleek MRU tab switcher for Chromium browsers.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Switchy settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shortcut.js", "favicon-guard.js", "switcher.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "onboarding.html",
    "open_in_tab": true
  }
}
